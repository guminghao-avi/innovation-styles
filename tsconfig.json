{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": false, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true, "allowJs": true, "resolveJsonModule": true,
    "paths": { "@kit": ["./src/kit"], "@kit/*": ["./src/kit/*"], "@styles/*": ["./src/styles/*"], "@proj/*": ["./projects/示例_纸艺手绘/*"] }
  },
  "include": ["src", "projects/*/*.tsx", "projects/*/*.ts"]
}
