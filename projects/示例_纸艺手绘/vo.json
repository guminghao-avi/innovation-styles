  "lines": [
    {"id": "a1", "text": "计划表上写着：**今天**开始。", "gap": 0, "hold": 0.8},
    {"id": "a2", "text": "然后变成「明天」、「下周」、「下个月」……", "gap": 0.4, "hold": 1.0},
    {"id": "b1", "text": "拖延不是懒，", "gap": 0.6, "hold": 0.3},
    {"id": "b2", "text": "是大脑在**躲开**一件让它难受的事。", "gap": 0.3, "hold": 0.8},
    {"id": "c1", "text": "那就先做**两分钟**。", "gap": 0.7, "hold": 1.4}
  ] }
